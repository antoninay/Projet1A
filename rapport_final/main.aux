\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Benchmark de performance : POD+EIM vs alternatives. Le facteur d'accélération atteint \textbf  {62×} pour 1000 évaluations.}}{17}{table.caption.9}\protected@file@percent }
\newlabel{tab:performance_breakdown}{{1}{17}{Benchmark de performance : POD+EIM vs alternatives. Le facteur d'accélération atteint \textbf {62×} pour 1000 évaluations}{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.9.4}Erreur globale du modèle réduit}{17}{subsubsection.2.9.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  \textbf  {Compromis erreur-performance (Pareto front).} Chaque point représente une paire $(r, m)$ de nombre de modes. Les points sont coloriés par $m$ (nombre de modes EIM). Cette vue révèle le chemin optimal : pour augmenter la précision, on peut soit augmenter $r$ (meilleure base POD), soit augmenter $m$ (meilleure approximation affine). Le point recommandé $(r=20, m=50)$ réalise le meilleur compromis : erreur relative $< 10^{-3}$ avec un temps online ultra-court (0.8 ms/eval). }}{18}{figure.caption.10}\protected@file@percent }
\newlabel{fig:tradeoff}{{8}{18}{\textbf {Compromis erreur-performance (Pareto front).} Chaque point représente une paire $(r, m)$ de nombre de modes. Les points sont coloriés par $m$ (nombre de modes EIM). Cette vue révèle le chemin optimal : pour augmenter la précision, on peut soit augmenter $r$ (meilleure base POD), soit augmenter $m$ (meilleure approximation affine). Le point recommandé $(r=20, m=50)$ réalise le meilleur compromis : erreur relative $< 10^{-3}$ avec un temps online ultra-court (0.8 ms/eval)}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.9.5}Visualisation des champs : Qualité visuelle}{18}{subsubsection.2.9.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces  \textbf  {Comparaison des solutions : HDM vs ROM.} Trois solutions de pression pour un même paramètre test : le modèle haute fidélité (gauche), le modèle POD seul (centre), et le modèle POD+EIM C$^{\infty }$ (droite). À l'échelle macroscopique, les trois champs sont visuellement identiques. Des différences microstructurelles apparaissent uniquement dans les zoom régionaux proches de la fracture, où le lissage sigmoïde introduit une zone de transition que Heaviside ne possèderait pas. }}{19}{figure.caption.11}\protected@file@percent }
\newlabel{fig:solution_comparison}{{9}{19}{\textbf {Comparaison des solutions : HDM vs ROM.} Trois solutions de pression pour un même paramètre test : le modèle haute fidélité (gauche), le modèle POD seul (centre), et le modèle POD+EIM C$^{\infty }$ (droite). À l'échelle macroscopique, les trois champs sont visuellement identiques. Des différences microstructurelles apparaissent uniquement dans les zoom régionaux proches de la fracture, où le lissage sigmoïde introduit une zone de transition que Heaviside ne possèderait pas}{figure.caption.11}{}}
